# Générer chaque valeur : python -c "import secrets;print(secrets.token_urlsafe(48))"
# PostgreSQL managé, TLS obligatoire
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=
# Générer : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
USERNAME_INDEX_KEY=
COOKIE_SECURE=0   # 0 uniquement en local sans HTTPS
